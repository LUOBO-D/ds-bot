# ============================================================
#  DS Bot 配置示例
#  复制为 .env 后按需修改：cp .env.example .env
#  .env 已被 .gitignore 忽略，不会提交到仓库
# ============================================================

# ------------------------------------------------------------
# 1) 本服务
# ------------------------------------------------------------
QB_HOST=127.0.0.1
QB_PORT=3001
# 管理接口的 Bearer Token；留空则首次启动自动生成并写回 .env
ADMIN_TOKEN=
QB_DB=data/qqbot.db
# 消息发送节流（防止触发 QQ 风控）
QB_MIN_SEND_INTERVAL=1.0
QB_MAX_SENDS_PER_MINUTE=90
QB_SEND_SPACING=0.35
QB_SEND_SOFT_LIMIT=60
QB_CALL_TIMEOUT=15
QB_BRAIN_TIMEOUT=120

# ------------------------------------------------------------
# 2) 大脑：任何 OpenAI 兼容的 Chat Completions 服务
#    默认 DeepSeek；换成别的服务只要改下面三项
# ------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 识图用的模型（需要支持 image_url 输入；DeepSeek 用 deepseek-chat）
VISION_MODEL=deepseek-chat
BRAIN_MAX_CONCURRENCY=4
BRAIN_QUEUE_TIMEOUT=30
BRAIN_PRESENCE_PENALTY=0.4
BRAIN_FREQUENCY_PENALTY=0.3

# ------------------------------------------------------------
# 3) OneBot 网关（NapCat 11）
#    NapCat 侧「网络配置 → WebSocket 客户端」指向：
#    ws://127.0.0.1:3001/onebot/v11/ws
# ------------------------------------------------------------
OB_WS_PATH=/onebot/v11/ws
# 可选：NapCat HTTP 服务地址，WS 未连接时兜底
OB_HTTP_BASE=
# 可选：WS 访问令牌，NapCat 侧填同名 token
OB_ACCESS_TOKEN=
# 可选：机器人 QQ 号，0 = 连接后自动获取
QB_SELF_ID=0

# ------------------------------------------------------------
# 4) 自动回复范围
#    ""（留空）= 只入库不回复；"*"/all/friends = 所有好友；
#    也可以写 10001,10002 = 只回这些号（非好友/临时会话一律不回）
# ------------------------------------------------------------
AUTO_REPLY_ENABLED=1
AUTO_REPLY_ALLOWLIST=
AUTO_REPLY_GAP=1.2
AUTO_REPLY_HISTORY=30
AUTO_REPLY_STALE=90
REPLY_MULTI=1
REPLY_MULTI_MAX=4
REPLY_BUBBLE_DELAY_MIN=0.5
REPLY_BUBBLE_DELAY_MAX=1.6
FOLLOWUP_ENABLED=1
FOLLOWUP_PROBABILITY=0.3
FOLLOWUP_DELAY_MIN=25
FOLLOWUP_DELAY_MAX=90

# ------------------------------------------------------------
# 5) 人格与记忆
#    PERSONA_DEFAULT 为默认角色卡 slug（对应 assets/personas/<slug>.md）
# ------------------------------------------------------------
PERSONA_DEFAULT=shenzhiwei
MEMORY_RECALL_K=8
MEMORY_MEMO_ENABLED=1
MEMORY_MEMO_MIN_MSGS=6
MEMORY_MEMO_MIN_SECONDS=180
MEMORY_MEMO_MAX_MSGS=120
MEMORY_MEMO_MAX_CHARS=900
REFLECTION_ENABLED=1
MOOD_ENABLED=1
LIFE_ENABLED=1
LIFE_TICK_SECONDS=900
LIFE_EVENT_PROBABILITY=0.5
NIGHTLY_TIME=23:30
MOOD_BASE_VALENCE=0.44
MOOD_BASE_AROUSAL=0.38
MOOD_BASE_ENERGY=0.70

# ------------------------------------------------------------
# 6) 识图（NapCat OCR + 视觉模型）
# ------------------------------------------------------------
VISION_ENABLED=1
VISION_OCR_ENABLED=1
VISION_MAX_BYTES=8388608
VISION_TIMEOUT=30

# ------------------------------------------------------------
# 7) 语音转文字（本地 SenseVoice，可选）
#    模型下载见 docs/SETUP.md；ASR_ENABLED=0 可关闭
# ------------------------------------------------------------
ASR_ENABLED=0
ASR_ENGINE=sensevoice
ASR_LANGUAGE=auto
ASR_MODEL_DIR=models/sense-voice
ASR_PARAFORMER_DIR=models/paraformer-zh
ASR_SILK_EXE=tools/silk/silk_v3_decoder.exe
ASR_THREADS=4
ASR_TIMEOUT=120
ASR_MAX_BYTES=10485760
ASR_CHUNK_SECONDS=30
ASR_FALLBACK=paraformer
ASR_CACHE=1
ASR_EMOTION_HINT=1
VOICE_DIR=data/voice

# ------------------------------------------------------------
# 8) 表情包库
# ------------------------------------------------------------
STICKER_ENABLED=1
STICKER_MAX=200
STICKER_SEND_PROBABILITY=0.3
STICKER_SEND_COOLDOWN=900
STICKER_SEND_DAILY_MAX=8
STICKER_JUDGE_TEMPERATURE=0.3

# ------------------------------------------------------------
# 9) 主动行为（默认关闭，确认风控可控后再开）
# ------------------------------------------------------------
PROACTIVE_ENABLED=0
POKE_ENABLED=0
POKE_TARGET=0
POKE_COOLDOWN_SECONDS=10800
POKE_DAILY_MAX=3
POKE_IDLE_SECONDS=5400
POKE_WINDOW_START=9
POKE_WINDOW_END=23
POKE_MESSAGE_PROBABILITY=0.7

# ------------------------------------------------------------
# 10) QQ 空间（可选 sidecar：onebot-qzone）
#     QZONE_ACCESS_TOKEN 必须与 services/onebot-qzone/.env 的
#     ONEBOT_ACCESS_TOKEN 一致
# ------------------------------------------------------------
QZONE_BASE=http://127.0.0.1:5700
QZONE_ACCESS_TOKEN=
QZONE_AUTO_FEED_ENABLED=0
QZONE_FEED_DAILY_MAX=2
QZONE_FEED_MIN_HOURS=3
QZONE_FEED_WINDOW_START=10
QZONE_FEED_WINDOW_END=22
QZONE_FEED_IMPULSE_PROBABILITY=0.12
QZONE_FEED_CHAT_PROBABILITY=0.15

# ------------------------------------------------------------
# 11) 社交线（刷好友动态 / 点赞 / 评论，需要空间 sidecar）
# ------------------------------------------------------------
SOCIAL_ENABLED=1
SOCIAL_BROWSE_INTERVAL_SECONDS=1800
SOCIAL_BROWSE_DAILY_MAX=6
SOCIAL_BROWSE_PROBABILITY=0.5
SOCIAL_WINDOW_START=9
SOCIAL_WINDOW_END=23
SOCIAL_NUM=8
SOCIAL_CHAT_COOLDOWN_SECONDS=120
SOCIAL_JUDGE_ENABLED=1
SOCIAL_JUDGE_MIN_INTEREST=0.5
SOCIAL_AUTO_LIKE_PROBABILITY=0.4
SOCIAL_AUTO_COMMENT_PROBABILITY=0.12
# 你自己的 QQ 号（用于区分「她自己的说说」与好友动态、评论权限）
OWNER_UID=0
